#: auth.jl
msgid "Enter a valid username."
msgstr "Bitte einen gültigen Benutzernamen eingeben."

#: forms.jl
msgid "Enter a list of values."
msgstr "Bitte eine Liste mit Werten eingeben."

#: forms.jl
msgid "Select a valid choice. One of the selected values is not one of the available choices."
msgstr "Bitte eine gültige Auswahl treffen. Einer der ausgewählten Werte ist keine gültige Auswahl."

#: forms.jl
msgid "Enter a whole number."
msgstr "Bitte eine ganze Zahl eingeben."

#: forms.jl
msgid "Enter a number."
msgstr "Bitte eine Zahl eingeben."

#: forms.jl
msgid "Enter a valid date/time."
msgstr "Bitte ein gültiges Datum und eine gültige Uhrzeit eingeben."

#: forms.jl
msgid "Enter a valid date."
msgstr "Bitte ein gültiges Datum eingeben."

#: forms.jl
msgid "Enter a valid JSON."
msgstr "Bitte gültiges JSON eingeben."

#: forms.jl
msgid "Enter a comma-separated list of valid values."
msgstr "Bitte eine kommagetrennte Liste gültiger Werte eingeben."

#: forms.jl
msgid "Enter a valid geometry (WKT or GeoJSON)."
msgstr "Bitte eine gültige Geometrie (WKT oder GeoJSON) eingeben."

#: forms.jl
msgid "Enter a valid UUID."
msgstr "Bitte eine gültige UUID eingeben."

#: forms.jl
msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Bitte eine gültige Auswahl treffen. Dies ist keine gültige Auswahl."

#: forms.jl
#: forms.jl
#: orm.jl
msgid "This field is required."
msgstr "Dieses Feld ist zwingend erforderlich."

#: forms.jl
#: orm.jl
msgid "%(model)s with this %(field)s already exists."
msgstr "%(model)s mit diesem Wert für %(field)s existiert bereits."

#: forms.jl
msgid "Please either submit a file or check the clear checkbox, not both."
msgstr "Bitte wählen Sie entweder eine Datei aus oder wählen Sie „Löschen“, nicht beides."

#: forms.jl
msgid "The submitted file is empty."
msgstr "Die ausgewählte Datei ist leer."

#: forms.jl
msgid "Ensure this filename has at most %(max)d characters (it has %(len)d)."
msgstr "Bitte sicherstellen, dass der Dateiname höchstens %(max)d Zeichen hat (er hat %(len)d)."

#: forms.jl
msgid "Upload a valid image. The file you uploaded was either not an image or a corrupted image."
msgstr "Bitte ein gültiges Bild hochladen. Die hochgeladene Datei ist kein Bild oder ist defekt."

#: forms.jl
#: orm.jl
msgid "Enter a valid value."
msgstr "Bitte einen gültigen Wert eingeben."

#: orm.jl
msgid "Ensure this value has at most %(max)d characters (it has %(len)d)."
msgstr "Bitte sicherstellen, dass der Text höchstens %(max)d Zeichen hat (er hat %(len)d)."

#: orm.jl
msgid "Enter a valid email address."
msgstr "Bitte gültige E-Mail-Adresse eingeben."

#: orm.jl
msgid "Enter a valid “slug” consisting of letters, numbers, underscores or hyphens."
msgstr "Bitte ein gültiges Kürzel eingeben, bestehend aus Buchstaben, Ziffern, Unterstrichen und Bindestrichen."

#: orm.jl
msgid "Enter a valid URL."
msgstr "Bitte eine gültige Adresse eingeben."

#: orm.jl
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "Bitte eine gültige Auswahl treffen. %(value)s ist keine gültige Auswahl."

